{
    "position": "top",

    "modules-left": ["clock", "tray"],

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A %d %B}",
    },
    "battery": {
        "format": "{capacity}% 🔋",
    },
    "cpu": {
        "format": "CPU {}%",
    },
    "memory": {
        "format": "RAM {}%",
    },
    "network": {
        "format-wifi": " {essid}",
        "format-disconnected": "Offline",
    },
    "pulseaudio": {
        "format": "Volume {volume}%",
    },

    "modules-center": ["network", "battery", "pulseaudio"],

    "modules-right": ["cpu", "memory", "battery"],

    "height": 35,

    "spacing": 10,
}
