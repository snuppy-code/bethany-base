[global]
width = (100,300)
height = (0,400)
origin = top-right
offset = (30,30)
padding = 12
horizontal_padding = 15
corner_radius = 10
frame_color = "#608276"
separator_color= frame
highlight = "#8aadf4"

[urgency_low]
background = "#24273a"
foreground = "#cad3f5"

[urgency_normal]
background = "#24273a"
foreground = "#cad3f5"

[urgency_critical]
background = "#24273a"
foreground = "#cad3f5"
frame_color = "#c26161"
